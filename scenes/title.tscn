[node name="HowTo" type="Label" parent="." unique_id=287647207]
layout_mode = 0
offset_left = 290.0
offset_top = 244.0
offset_right = 990.0
offset_bottom = 560.0
theme_override_font_sizes/font_size = 16
text = "- Each day lasts 2 minutes. Drag task cards from your hand onto the work spot they name, in the barn or out on the farmstead.
- The kratt holds 3 orders at most and works through them on its own. It gets 15% faster at every job it repeats, so it needs more and more work.
- With nothing to do, its idle fuse burns. When the fuse runs out, it smashes a building and its cards. The third rampage kills you.
- The pastor visits once a day (see the timeline). Send the kratt somewhere far, or disguise it as a scarecrow, which stops it working.
- Pay the rent at dusk, then buy cards and charms at the night market. After day 4, order the ladder of bread."
autowrap_mode = 3

